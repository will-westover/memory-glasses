<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.memoryglasses.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>memoryglasses</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Records moments with the camera, like the glasses would.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Connects to your Memory Glasses server on this network.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Notes where each moment was recorded.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Turns what you say into a question when you hold the microphone button.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Records what was said during a moment.</string>
</dict>
</plist>
