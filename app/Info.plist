<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ServerAddress</key>
	<string>$(MEMORY_SERVER)</string>
	<key>ServerToken</key>
	<string>$(MEMORY_TOKEN)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.memoryglasses.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>memoryglasses</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Receives photos from your Memory Glasses and sends them to your server, and updates the glasses.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>location</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Records moments with the camera, like the glasses would.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Connects to your Memory Glasses server on this network.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Notes where each moment was recorded, by the phone or by the glasses while they're connected.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Turns what you say into a question when you hold the microphone button.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Records what was said during a moment.</string>
</dict>
</plist>
